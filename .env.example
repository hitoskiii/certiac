# ============================================================================
# Provider DNS actif. Doit correspondre à une paire de fichiers
# providers/<nom>.tls.caddyfile + providers/<nom>.ddns.caddyfile
# Livrés : duckdns | cloudflare | ovh | gandi
# ============================================================================
DNS_PROVIDER=duckdns

# Domaine racine. Sert aux matchers "host" du Caddyfile et au DNS dynamique.
DOMAIN=monserveur.duckdns.org

# Domaines réellement servis par le proxy.
#   DuckDNS     : wildcard SEUL. Un seul TXT possible par domaine, donc l'apex
#                 et le wildcard se piétinent (voir README §5.1).
#   Cloudflare  : on peut ajouter l'apex.
#                 -> SITE_ADDRESSES=mondomaine.fr, *.mondomaine.fr
SITE_ADDRESSES=*.monserveur.duckdns.org

# Port d'écoute SUR LA MACHINE HÔTE. À ne pas confondre avec le port externe.
# Le routeur doit rediriger 443 (externe) vers <ip-locale>:HTTPS_PORT.
# Les deux n'ont pas besoin d'être égaux : 443 -> 192.168.1.42:8443 fonctionne.
# En revanche le port EXTERNE doit être 443, sinon les URLs porteront le port.
HTTPS_PORT=443

# Sous-domaine de l'application de demandes : seerr.<DOMAIN> par défaut.
SEERR_SUBDOMAIN=seerr

# Backend de l'application de demandes (Overseerr / Jellyseerr / Seerr).
# ATTENTION : c'est le port publié SUR L'HOTE qu'il faut indiquer, pas le port
# interne au conteneur. "docker ps" montre 0.0.0.0:<hote>-><interne>/tcp.
# Exemples : host.docker.internal:5011  (port publié sur l'hôte)
#            seerr:5055                 (si le conteneur rejoint le réseau proxy)
#            192.168.1.50:5055          (autre machine du réseau)
SEERR_UPSTREAM=host.docker.internal:5011

# Adresse pour les notifications d'expiration Let's Encrypt.
ACME_EMAIL=toi@exemple.fr

# --- DuckDNS ----------------------------------------------------------------
# Le token affiché en haut de https://www.duckdns.org (un UUID).
# Unique par compte, pas par domaine.
DUCKDNS_API_TOKEN=

# --- Cloudflare -------------------------------------------------------------
# Token scopé, PAS la Global API Key.
# https://dash.cloudflare.com/profile/api-tokens > Create Custom Token
#   Zone / Zone / Read   +   Zone / DNS / Edit
#   Zone Resources : Include > Specific zone > <ton-domaine>
CLOUDFLARE_API_TOKEN=

# --- OVH --------------------------------------------------------------------
# https://api.ovh.com/createToken/ (GET/POST/PUT/DELETE sur /domain/zone/*)
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- Gandi ------------------------------------------------------------------
GANDI_API_TOKEN=
